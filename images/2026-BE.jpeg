<div class="fixed inset-0 z-60 pointer-events-none"
     data-ev-autoinit
     data-ev-component="CookieConsent">
    <!-- Cookie Banner -->
    <div class="fixed inset-x-2 bottom-2 md:bottom-6 md:right-6 md:left-auto md:w-md pointer-events-auto hidden"
         data-cookie-banner
         aria-hidden="true">
        <section role="dialog"
                 aria-modal="true"
                 aria-labelledby="cookie-title"
                 aria-describedby="cookie-desc"
                 class="rounded-lg bg-black/40 backdrop-blur-xl shadow-lg p-4">
            <div class="rich-text">
                <h2 id="cookie-title" class="text-sm">Eurofans need cookies!</h2>
            </div>
            <div class="rich-text">
                <p id="cookie-desc" class="mt-2 mb-1 text-sm text-white/80">
                    Want the full ‘douze points’ experience? We need your permission to allow cookies to remember your settings and understand how you interact with the site. We do not use your data to track you for advertising, or pass it to third parties for advertising purposes.
                </p>
                <p class="mt-2 text-sm text-white/80">
                    For details, check out our
                    
                    <a href="/privacy-policy">Privacy Policy</a>.
                    
                </p>
            </div>
            <div class="mt-4 flex flex-col-reverse gap-1 md:gap-2 md:flex-row md:items-center md:justify-end">
                <div class="flex gap-1 md:gap-2 w-full">
                    <button type="button"
                            class="btn btn-secondary text-sm flex-1 min-w-0"
                            data-allow-all>Allow all</button>
                    <button type="button"
                            class="btn btn-secondary text-sm flex-1 min-w-0"
                            data-reject-all>Reject all</button>
                </div>
                <button type="button"
                        class="btn outline-1 text-sm w-full md:w-auto min-w-[120px]"
                        data-open-preferences>Preferences</button>
            </div>
        </section>
    </div>
    <!-- Preferences Modal -->
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm pointer-events-auto hidden flex items-center justify-center p-4"
         data-cookie-preferences
         aria-hidden="true">
        <div role="dialog"
             aria-modal="true"
             aria-labelledby="preferences-title"
             class="bg-black/40 backdrop-blur-xl rounded-lg shadow-2xl p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="flex items-start justify-between mb-4">
                <h2 id="preferences-title" class="text-xl font-bold">Cookie Preferences</h2>
                <button type="button"
                        class="text-white/60 hover:text-white hover:cursor-pointer transition-colors"
                        data-close-preferences
                        aria-label="Close preferences"><svg class="" width="24" height="24" aria-hidden="true"><use href="#svg-close"></use></svg></button>
            </div>
            <div class="space-y-6">
                <!-- Functional Cookies (Always Required) -->
                <div class="border-b border-white/10 pb-4">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="font-semibold">Functional Cookies</h3>
                        <span class="text-sm text-white/60 bg-white/10 px-3 py-1 rounded-full">Always Active</span>
                    </div>
                    <p class="text-sm text-white/80 mb-3">These cookies are essential for the website to function properly.</p>
                </div>
                <!-- Analytics Cookies (Optional) -->
                <div class="pb-4">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="font-bold">Analytics Cookies</h3>
                        <label class="inline-flex items-center cursor-pointer">
                            <input type="checkbox"
                                   id="cookie-analytics"
                                   class="sr-only peer"
                                   aria-label="Toggle analytics cookies">
                            <div class="relative w-7 h-4 rounded-full peer bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:start-[4px] after:bg-white after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-accent">
                            </div>
                        </label>
                    </div>
                    <p class="text-sm text-white/80 mb-3">
                        These cookies help us understand how visitors interact with our website by collecting and reporting
                        information anonymously. This helps us improve the website experience.
                    </p>
                </div>
            </div>
            <div class="mt-6 flex gap-3 justify-end">
                <button type="button" class="btn outline-1 text-sm" data-close-preferences>Cancel</button>
                <button type="button" class="btn btn-secondary text-sm" data-save-preferences>Save Preferences</button>
            </div>
        </div>
    </div>
</div>

        
    </body>
</html>
